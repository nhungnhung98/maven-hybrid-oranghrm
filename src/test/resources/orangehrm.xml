<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM- UI Automation Test">

    <parameter name="browser" value="http://localhost:88/orangehrm"></parameter>

    <listeners>
        <listener class-name="core.MethodListener"></listener>
        <listener class-name="jiraConfigs.JiraListener"></listener>
    </listeners>

    <test name="Run on FIREFOX browser">
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="com.orangehrm.Login_17_Jira"/>
        </classes>
    </test>


</suite>